{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "csy20-works.vercel.app" }],
      "destination": "https://csy20.me/:path*",
      "permanent": true
    }
  ]
}
