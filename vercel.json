{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/csy20_resume.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"csy20_resume.pdf\""
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/((?!csy20_resume\\.pdf).*)", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "csy20-works.vercel.app" }],
      "destination": "https://csy20.me/:path*",
      "permanent": true
    }
  ]
}
